// Prisma schema for the Faculty Allocation System.
//
// Main relationships:
//
// Department 1 ──── many Faculty
//
// Faculty    1 ──── many Allocation
// Office     1 ──── many Allocation
//
// Allocation acts as the connection between a faculty member
// and an office while also preserving assignment history.

generator client {
    provider = "prisma-client"
}

datasource db {
    provider = "postgresql"
}


// Employment/tenure categories used when classifying faculty.
// These values will later contribute to office recommendations.
enum TenureStatus {
    TENURED
    TENURE_TRACK
    FIXED_TERM
}


// Physical spaces are currently classified as either a traditional
// office or a cubicle. Space type will later affect recommendations.
enum SpaceType {
    OFFICE
    CUBICLE
}

// Office spaces can be classified accordingly depending on their availability.
// Office availability will later affect future allocation recommendations.
enum OfficeStatus {
    AVAILABLE
    RESERVED
    UNAVAILABLE
}


// Faculty hierarchy supplied for the allocation system.
// Rank will later be used as one factor in office recommendations.
enum FacultyRank {
    FULL
    ASSOCIATE
    ASSISTANT
    INSTRUCTIONAL_FULL
    INSTRUCTIONAL_ASSOCIATE
    INSTRUCTIONAL_ASSISTANT
    SENIOR_LECTURER
    LECTURER_INSTRUCTOR
    VISITING_INSTRUCTIONAL_ASSISTANT
    VISITING_LECTURER
    VISITING_ASSISTANT
}


// Represents an individual faculty member.
//
// departmentId is the foreign key connecting Faculty to Department.
// A faculty member can have multiple Allocation records over time,
// allowing the system to preserve their office-assignment history.
model Faculty {
    id              Int          @id @default(autoincrement())
    firstName       String
    lastName        String
    email           String?       @unique
    tenureStatus    TenureStatus
    facultyRank     FacultyRank
    otherNotes      String?
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt

    departmentId    Int
    department      Department   @relation(fields: [departmentId], references: [id])

    allocations     Allocation[]

    // The login account for this faculty member, if one has been created.
    user            User?

    // Corrections and office problems this member reported from the Faculty Portal.
    requests        FacultyRequest[]

    // A one-time code the administrator gives this member so they can
    // create their own login account at /activate.
    activationCode  ActivationCode?
}


// Represents a physical assignable space.
//
// Availability is intentionally NOT stored here as an isAvailable Boolean.
// Instead, an office is occupied when it has an Allocation where
// endedAt is null. This prevents two separate sources of truth.
//
// hasWindow and spaceType will later be used by the recommendation system.
model Office {
    id              Int          @id @default(autoincrement())
    building        String
    roomNumber      String
    floor           Int
    hasWindow       Boolean
    spaceType       SpaceType
    status          OfficeStatus    @default(AVAILABLE)
    capacity        Int         @default(1)
    notes           String? 

    allocations     Allocation[]
}


// Represents an academic department.
//
// building is currently nullable because the official department-to-building
// assignments have not yet been provided. Once confirmed, this field can
// participate in the office recommendation system.
//
// One Department can contain many Faculty members.
model Department {
    id              Int          @id @default(autoincrement())
    name            String       @unique
    building        String?

    facultyMembers  Faculty[]
}


// Represents the assignment of one faculty member to one office.
//
// assignedAt = when the assignment began.
// endedAt = null means the allocation is CURRENTLY ACTIVE.
// endedAt = timestamp means the allocation has ended.
//
// Records should normally be ended rather than deleted so that historical
// faculty-office assignments remain available for future reporting.
model Allocation {
    id              Int          @id @default(autoincrement())

    facultyId       Int
    officeId        Int

    assignedAt      DateTime     @default(now())
    endedAt         DateTime?

    faculty         Faculty      @relation(fields: [facultyId], references: [id])
    office          Office       @relation(fields: [officeId], references: [id])
}

// A record of every change made through the admin pages
// (edits, deletes, status changes, assignments, imports).
//
// Rows are only ever added, never edited, so the list is a
// trustworthy history of what changed and when.
model ChangeLog {
    id              Int          @id @default(autoincrement())
    action          String       // e.g. "Edited faculty"
    entity          String       // "Faculty", "Office", "Allocation" or "Import"
    entityId        Int?         // id of the record that changed, if any
    details         String       // what changed, e.g. "Window: No → Yes"

    // Who made the change. The name and email are copied at the time of
    // the change, so the history still shows them if the account is later
    // deleted or renamed. Empty for changes made by scripts.
    actorId         Int?
    actorName       String?
    actorEmail      String?
    actorRole       String?
    createdAt       DateTime     @default(now())
}

// Who can sign in and what they are allowed to do.
//
// ADMIN   - full access to the admin pages (faculty, offices, assignments,
//           imports, history and user accounts).
// FACULTY - can sign in to the Faculty Portal and see their own office.
enum UserRole {
    ADMIN
    FACULTY
}


// A login account.
//
// Passwords are never stored in plain text: passwordHash holds a salted
// scrypt hash produced by src/lib/auth/password.ts.
//
// facultyId optionally links the account to a Faculty record so the
// Faculty Portal can show that person's office. Admin accounts normally
// leave it empty. If the faculty record is deleted the link is cleared
// rather than deleting the account.
model User {
    id              Int          @id @default(autoincrement())
    email           String       @unique
    name            String
    passwordHash    String
    role            UserRole     @default(FACULTY)
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt

    facultyId       Int?         @unique
    faculty         Faculty?     @relation(fields: [facultyId], references: [id], onDelete: SetNull)
}


// What a faculty member is reporting from the Faculty Portal.
//
// CORRECTION   - some of their information looks wrong (rank, email, office...).
// OFFICE_ISSUE - a problem with their office (keys, furniture, maintenance...).
enum RequestType {
    CORRECTION
    OFFICE_ISSUE
}

enum RequestStatus {
    OPEN
    RESOLVED
}


// A message sent from the Faculty Portal to the COAS administrators.
//
// Faculty can only create requests and see their own; administrators see
// all of them on /admin/requests and mark them resolved. Requests never
// change data by themselves: an administrator reviews them and makes any
// change through the normal admin pages.
model FacultyRequest {
    id              Int            @id @default(autoincrement())
    type            RequestType
    topic           String         // e.g. "Rank", "Email", "Office", "Keys"
    message         String
    status          RequestStatus  @default(OPEN)
    adminNote       String?        // optional reply shown to the faculty member
    seenByFaculty   Boolean        @default(true) // false = resolved, the member has not seen the answer yet
    createdAt       DateTime       @default(now())
    resolvedAt      DateTime?

    facultyId       Int
    faculty         Faculty        @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}


// One-time activation code for a faculty member.
//
// Instead of the administrator creating every account by hand, they
// generate a code on /admin/accounts and give it to the faculty member.
// The member opens /activate, enters the code, their email and a password
// of their choice, and the account is created and linked to their faculty
// record. The code is deleted as soon as it is used, and stops working
// after expiresAt.
model ActivationCode {
    id              Int          @id @default(autoincrement())
    code            String       @unique   // e.g. "K7MQ4XTP" (shown as K7MQ-4XTP)
    createdAt       DateTime     @default(now())
    expiresAt       DateTime

    facultyId       Int          @unique
    faculty         Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}
